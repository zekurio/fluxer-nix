+-spec listen_ip() -> [inet6 | {ip, inet:ip_address()}].
+listen_ip() ->
+    case os:getenv("FLUXER_GATEWAY_LISTEN_HOST", "") of
+        "" ->
+            [];
+        Host ->
+            {ok, Ip} = inet:parse_address(Host),
+            case tuple_size(Ip) of
+                8 -> [inet6, {ip, Ip}];
+                4 -> [{ip, Ip}]
+            end
+    end.
+
